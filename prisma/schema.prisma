// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  role          Role      @default(USER)
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Для Auth
  accounts      Account[]
  sessions      Session[]

  // Связи с заказами/корзиной
  // orders      Order[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Drug {
  id                 String   @id @default(cuid())
  name               String   // торговое название
  mnn                String   // международное непатентованное название (действующее вещество)
  category           String   // терапевтическая группа
  form               Form     // лекарственная форма
  dosage             String   // дозировка (например, "500 мг")
  manufacturer       String
  price              Float
  imageUrl           String?  // ссылка на изображение
  slug               String   @unique // для красивых URL

  // Связь с активными ингредиентами (многие-ко-многим)
  ingredients        DrugIngredient[]

  // Поля с текстовой информацией (JSON)
  indications        Json     // массив строк: ["головная боль", "лихорадка"]
  contraindications  Json     // массив строк
  sideEffects        Json     // массив строк
  interactions       Json     // массив строк

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("drugs")
}

enum Form {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
}

// Промежуточная таблица для связи Drug <-> ActiveIngredient
model DrugIngredient {
  id           String            @id @default(cuid())
  drugId       String
  ingredientId String
  amount       String            // например, "500 мг"
  drug         Drug              @relation(fields: [drugId], references: [id], onDelete: Cascade)
  ingredient   ActiveIngredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([drugId, ingredientId])
  @@map("drug_ingredients")
}

model ActiveIngredient {
  id         String   @id @default(cuid())
  name       String   @unique // МНН (уникальное)
  drugIngredients DrugIngredient[]

  @@map("active_ingredients")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}